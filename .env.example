# OPENROUTER_API_KEY: Required for OpenRouter AI API calls.
# Users configure this in their environment variables.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PANEL_PASSWORD: Password required to access and unlock the API Admin Panel.
PANEL_PASSWORD="admin_nexus_2026"
