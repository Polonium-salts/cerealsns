# OPENROUTER_API_KEY: Required for OpenRouter AI API calls.
# Users configure this in their environment variables.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SEARXNG_INSTANCES: Comma-separated list of SearXNG instance URLs.
SEARXNG_INSTANCES="https://xka.cz,https://searx.prvcy.eu,https://searx.ro,https://failsearx.culturanerd.it/"

